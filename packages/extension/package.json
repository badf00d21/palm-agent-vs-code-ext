{
  "name": "palm-agent",
  "displayName": "Palm Agent",
  "description": "In-editor coding agent (Mozaik runtime)",
  "version": "0.0.1",
  "publisher": "palm-agent",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:palmAgent.chat",
    "onCommand:agent.focus",
    "onCommand:palmAgent.newChat"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "palm-agent",
          "title": "Palm Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "palm-agent": [
        {
          "type": "webview",
          "id": "palmAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "agent.focus",
        "title": "Palm Agent: Focus Chat"
      },
      {
        "command": "palmAgent.newChat",
        "title": "Palm Agent: New Chat"
      },
      {
        "command": "palmAgent.setDeepseekApiKey",
        "title": "Palm Agent: Set DeepSeek API Key"
      },
      {
        "command": "palmAgent.clearDeepseekApiKey",
        "title": "Palm Agent: Clear DeepSeek API Key"
      }
    ],
    "keybindings": [
      {
        "command": "agent.focus",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ],
    "configuration": {
      "title": "Palm Agent",
      "properties": {
        "palmAgent.model": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "enum": [
            "deepseek-v4-flash",
            "deepseek-v4-pro"
          ],
          "enumDescriptions": [
            "Fast / cheaper DeepSeek V4 — default for interactive chat",
            "Stronger DeepSeek V4 — heavier planning and harder edits"
          ],
          "description": "DeepSeek model. Only V4 Flash and Pro are supported in this release."
        },
        "palmAgent.deepseekApiKey": {
          "type": "string",
          "default": "",
          "description": "DeepSeek API key. Prefer “Palm Agent: Set DeepSeek API Key” (Secret Storage). This setting is a fallback and is stored in settings.json in plain text."
        },
        "palmAgent.maxOutputTokens": {
          "type": "integer",
          "default": 32000,
          "minimum": 1024,
          "description": "Output budget per completion. A reasoning model spends this on thinking before it writes any answer, so too low a value ends turns with an empty reply and finish_reason \"length\"."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run build:webview && npm run build:ext",
    "build:ext": "node esbuild.mjs && node scripts/sync-vendor.mjs",
    "build:webview": "vite build --config vite.config.ts",
    "watch": "node esbuild.mjs --watch",
    "watch:webview": "vite build --config vite.config.ts --watch",
    "package": "node scripts/package-vsix.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@palm-agent/agent-core": "workspace:*",
    "@palm-agent/shared": "workspace:*",
    "@vscode/ripgrep": "^1.15.9",
    "dotenv": "^17.4.2",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.6",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.4.1",
    "esbuild": "^0.25.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
